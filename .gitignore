# Agile611 Koinos RISC-V Distribution - Git Ignore Rules

# =============================================================================
# Build Artifacts & Output Directories
# =============================================================================

# Kernel build outputs
linux-*/
*.dtb
*.dtbo
Image
Image.gz
vmlinux
vmlinuz*
System.map*
Module.symvers
modules.order
*.ko
*.mod.c
*.mod.o
.cmd/
.kconfig/
.kconfig.d/
*.txt
!overlays/boot/cmdline.txt

# Device Tree Compiler outputs
*.dtb
*.dtbo

# Rootfs & image builds
rootfs/
rootfs-*/
*.img
*.iso
*.qcow2
*.raw
*.tar
*.tar.gz
*.tar.xz
*.tar.zst
boot/
boot-*/
!overlays/boot/
efi/
efi-*/
!overlays/boot/EFI/BOOT/BOOTRISCV64.EFI

# mmdebstrap/debootstrap outputs
/var/cache/apt/
/var/lib/apt/lists/
*.deb
*.udeb

# Buildroot outputs
output/
buildroot-*/output/

# =============================================================================
# Toolchain & Cross-Compilation
# =============================================================================

# Cross-toolchain
/opt/riscv/
/opt/toolchains/
riscv64-linux-gnu-*
*.a
*.so
*.so.*
*.o
*.obj

# ccache
.ccache/
ccache-*/

