#!/usr/bin/make -f

%:
	dh $@

override_dh_auto_configure:
	# No configure step needed - we create directory structure

override_dh_auto_build:
	# Create hwcaps directory structure
	mkdir -p debian/koinv-hwcaps/usr/lib/riscv64-linux-gnu/hwcaps/RVA23U64
	
	# Install hwcaps detection helper
	install -D -m 755 ../overlays/usr/local/bin/koinv-hwcaps-detect \
		debian/koinv-hwcaps/usr/local/bin/koinv-hwcaps-detect
	
	# Create hwcaps verification script
	cat > debian/koinv-hwcaps/usr/local/bin/koinv-hwcaps-verify << 'VERIFYEOF'
#!/bin/bash
# KoinV HWCapS Verification Script
# Verifies that glibc-hwcaps and IFUNC are working for RVA23U64

set -euo pipefail

echo "=== KoinV HWCapS Verification ==="
echo ""

# Check hwcaps directory
HWCAPS_DIR="/usr/lib/riscv64-linux-gnu/hwcaps/RVA23U64"
if [[ -d "$HWCAPS_DIR" ]]; then
    echo "✓ hwcaps directory exists: $HWCAPS_DIR"
    ls -la "$HWCAPS_DIR"
else
    echo "✗ hwcaps directory missing: $HWCAPS_DIR"
    exit 1
fi

# Check hwprobe syscall
echo ""
echo "Checking hwprobe syscall..."
if grep -q "riscv_hwprobe" /proc/kallsyms 2>/dev/null; then
    echo "✓ hwprobe syscall available in kernel"
else
    echo "⚠ hwprobe syscall not found in /proc/kallsyms"
fi

# Test hwprobe via perl
echo ""
echo "Testing hwprobe syscall..."
perl -e '
    use strict;
    use warnings;
    my $key = 1;  # RISCV_HWPROBE_KEY_IMA_EXT_0
    my $buf = pack("QQ", 0, 0);
    my $ret = syscall(442, $key, $buf, 16, 0);  # SYS_riscv_hwprobe = 442
    if ($ret == 0) {
        my ($val, $mask) = unpack("QQ", $buf);
        printf "hwprobe returned: value=0x%x mask=0x%x\n", $val, $mask;
        if ($val & 0x80000000) {
            print "RVA23U64 profile SUPPORTED\n";
        } else {
            print "RVA23U64 profile NOT detected\n";
        }
    } else {
        print "hwprobe syscall failed: $!\n";
    }
' 2>/dev/null || echo "hwprobe test failed (may need kernel support)"

# Check IFUNC support
echo ""
echo "Checking IFUNC support..."
if readelf -s /lib/riscv64-linux-gnu/libc.so.6 2>/dev/null | grep -q "IFUNC"; then
    echo "✓ IFUNC resolvers found in libc"
else
    echo "⚠ IFUNC resolvers not found in libc"
fi

# Check optimized libraries
echo ""
echo "Checking optimized libraries in hwcaps..."
for lib in libcrypto.so libgcrypt.so libjpeg.so; do
    if [[ -f "/usr/lib/riscv64-linux-gnu/hwcaps/RVA23U64/$lib" ]]; then
        echo "✓ Found optimized $lib"
    else
        echo "⚠ Missing optimized $lib"
    fi
done

echo ""
echo "=== Verification Complete ==="
VERIFYEOF
	chmod +x debian/koinv-hwcaps/usr/local/bin/koinv-hwcaps-verify

override_dh_auto_install:
	dh_install --sourcedir=debian/tmp --fail-missing

override_dh_install:
	dh_install --sourcedir=debian/tmp --fail-missing

override_dh_installdirs:
	dh_installdirs \
		usr/lib/riscv64-linux-gnu/hwcaps/RVA23U64 \
		usr/local/bin

override_dh_install:
	dh_install --sourcedir=debian/tmp --fail-missing
