#!/bin/bash
# KoinV HWCapS Detection Helper
# Detects RISC-V hardware capabilities via hwprobe syscall

set -euo pipefail

# RISC-V hwprobe constants (from linux/arch/riscv/include/uapi/asm/hwprobe.h)
RISCV_HWPROBE_KEY_IMA_EXT_0=0x00000001
RISCV_HWPROBE_KEY_IMA_EXT_1=0x00000002
RISCV_HWPROBE_KEY_IMA_EXT_2=0x00000003
RISCV_HWPROBE_KEY_IMA_EXT_3=0x00000004
RISCV_HWPROBE_KEY_IMA_EXT_4=0x00000005
RISCV_HWPROBE_KEY_IMA_EXT_5=0x00000006
RISCV_HWPROBE_KEY_IMA_EXT_6=0x00000007
RISCV_HWPROBE_KEY_IMA_EXT_7=0x00000008

# Extension bits
RISCV_HWPROBE_EXT_ZICBOM=0x00000001
RISCV_HWPROBE_EXT_ZICBOP=0x00000002
RISCV_HWPROBE_EXT_ZICBOZ=0x00000004
RISCV_HWPROBE_EXT_ZICBCM=0x00000008
RISCV_HWPROBE_EXT_ZICBCMT=0x00000010
RISCV_HWPROBE_EXT_ZICBOM=0x00000020
RISCV_HWPROBE_EXT_ZICBOP=0x00000040
RISCV_HWPROBE_EXT_ZICBOZ=0x00000080
RISCV_HWPROBE_EXT_ZICBCM=0x00000100
RISCV_HWPROBE_EXT_ZICBCMT=0x00000200
RISCV_HWPROBE_EXT_ZICBCMT=0x00000400
RISCV_HWPROBE_EXT_ZICBCMT=0x00000800
RISCV_HWPROBE_EXT_ZICBCMT=0x00001000
RISCV_HWPROBE_EXT_ZICBCMT=0x00002000
RISCV_HWPROBE_EXT_ZICBCMT=0x00004000
RISCV_HWPROBE_EXT_ZICBCMT=0x00008000
RISCV_HWPROBE_EXT_ZICBCMT=0x00010000
RISCV_HWPROBE_EXT_ZICBCMT=0x00020000
RISCV_HWPROBE_EXT_ZICBCMT=0x00040000
RISCV_HWPROBE_EXT_ZICBCMT=0x00080000
RISCV_HWPROBE_EXT_ZICBCMT=0x00100000
RISCV_HWPROBE_EXT_ZICBCMT=0x00200000
RISCV_HWPROBE_EXT_ZICBCMT=0x00400000
RISCV_HWPROBE_EXT_ZICBCMT=0x00800000
RISCV_HWPROBE_EXT_ZICBCMT=0x01000000
RISCV_HWPROBE_EXT_ZICBCMT=0x02000000
RISCV_HWPROBE_EXT_ZICBCMT=0x04000000
RISCV_HWPROBE_EXT_ZICBCMT=0x08000000
RISCV_HWPROBE_EXT_ZICBCMT=0x10000000
RISCV_HWPROBE_EXT_ZICBCMT=0x20000000
RISCV_HWPROBE_EXT_ZICBCMT=0x40000000
RISCV_HWPROBE_EXT_ZICBCMT=0x80000000

# RVA23U64 profile bit
RISCV_HWPROBE_RVA23U64=0x80000000

# hwprobe syscall number (riscv64)
SYS_riscv_hwprobe=442

# Detect capabilities using hwprobe syscall
detect_hwcaps() {
    local key=$1
    local result
    
    # Use perl to make the syscall
    result=$(perl -e "
        use strict;
        use warnings;
        my \$key = $key;
        my \$buf = pack('QQ', 0, 0);
        my \$ret = syscall($SYS_riscv_hwprobe, \$key, \$buf, 16, 0);
        if (\$ret == 0) {
            my (\$val, \$mask) = unpack('QQ', \$buf);
            printf \"0x%x 0x%x\", \$val, \$mask;
        } else {
            print \"ERROR \$!\";
        }
    " 2>/dev/null)
    
    echo "$result"
}

# Main
main() {
    echo "KoinV HWCapS Detection"
    echo "======================"
    
    # Check if hwprobe syscall is available
    if ! grep -q "riscv_hwprobe" /proc/kallsyms 2>/dev/null; then
        echo "WARNING: riscv_hwprobe syscall not available in kernel"
        echo "Falling back to /proc/cpuinfo parsing"
        parse_cpuinfo
        return
    fi
    
    # Probe IMA extensions
    for i in {0..7}; do
        local key=$((RISCV_HWPROBE_KEY_IMA_EXT_0 + i))
        local result=$(detect_hwcaps $key)
        if [[ "$result" != "ERROR"* && "$result" != "" ]]; then
            local val=$(echo $result | awk '{print $1}')
            local mask=$(echo $result | awk '{print $2}')
            if [[ $val -ne 0 || $mask -ne 0 ]]; then
                echo "IMA_EXT_$i: value=0x$val mask=0x$mask"
                if [[ $((val & RISCV_HWPROBE_RVA23U64)) -ne 0 ]]; then
                    echo "  -> RVA23U64 profile SUPPORTED"
                fi
            fi
        fi
    done
    
    # Check glibc-hwcaps directories
    echo ""
    echo "glibc-hwcaps directories:"
    for dir in /usr/lib/riscv64-linux-gnu/hwcaps/*/; do
        if [[ -d "$dir" ]]; then
            echo "  $(basename $dir)"
        fi
    done
}

parse_cpuinfo() {
    echo "Parsing /proc/cpuinfo for ISA extensions..."
    grep -m1 "isa" /proc/cpuinfo | sed 's/.*: //' | tr ' ' '\n' | sort -u | while read ext; do
        echo "  Extension: $ext"
    done
}

main "$@"
